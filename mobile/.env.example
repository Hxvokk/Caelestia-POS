# Copy this file to .env.local and fill in the public values from Supabase.
# Never put a service_role key, database password, or DeepSeek secret here.
EXPO_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
EXPO_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_YOUR_PUBLIC_KEY

# Android emulator: http://10.0.2.2:5141
# Physical Android device: http://YOUR_COMPUTER_LAN_IP:5141
EXPO_PUBLIC_API_URL=http://10.0.2.2:5141
